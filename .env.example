# Where the server keeps what it writes: the built-in database (pg/) and the icon caches (cache/).
# Default ./data (relative to where the server starts). The Docker image sets it to /data, which
# docker-compose.yml mounts as a volume. YAML pages left here by 1.x are imported on the first start.
# DATA_DIR=./data

# A Postgres server to keep pages in instead of the built-in database, as a postgres:// URL.
# Unset (the default) keeps them in DATA_DIR/pg. Migrations run on every start, on either database.
# DATABASE_URL=postgres://homepage:homepage@localhost:5432/homepage

# How long the server waits for Postgres at boot before giving up, in ms. Default 60000.
# Only used with DATABASE_URL.
# DB_CONNECT_TIMEOUT_MS=60000

# Port the server listens on in production (`npm start`, Docker). Default 3000.
# `npm run dev` ignores it: the web app is on 3000 and the API on 8787.
# PORT=3000

# Proxies in front of this server that may set X-Forwarded-For. Default false (none).
# "1" for one reverse proxy; never "true" when the port is reachable from the internet.
# TRUST_PROXY=1

# The Open-Meteo forecast endpoint weather widgets ask. Default https://api.open-meteo.com/v1/forecast.
# Set it to a self-hosted Open-Meteo's /v1/forecast to keep weather requests on your network.
# WEATHER_API_URL=http://open-meteo.lan:8080/v1/forecast

# Where people open the homepage, such as https://home.example.com. The OIDC sign-in sends the browser back
# here. Default http://localhost:PORT. `npm run dev` sets it to http://localhost:3000.
# APP_URL=http://localhost:3000

# What sign-in sessions are signed with. Unset, the server makes one on first start and keeps it in
# DATA_DIR/auth-secret. Set it to choose your own: `openssl rand -hex 32`. A weak one is refused.
# BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Sign in through an OpenID Connect provider (heautou, Keycloak, Authentik, …). The easier way is to leave
# these unset and paste heautou's setup URL into Settings: the homepage registers itself. Set here, the
# provider wins and can't be changed from the app. Register <APP_URL>/api/auth/callback/oidc with it.
# OIDC_ISSUER=https://id.example.com/oidc
# OIDC_CLIENT_ID=homepage
# OIDC_CLIENT_SECRET=
# client_secret_basic (default) or client_secret_post.
# OIDC_CLIENT_AUTH=client_secret_basic
# What the sign-in button calls it. Default SSO.
# OIDC_NAME=heautou
# The ID token claim a person's groups are read from. Default groups (heautou's).
# OIDC_GROUPS_CLAIM=groups

# Forward auth: the proxies (addresses or CIDR ranges, comma-separated) whose Remote-User, Remote-Email
# and Remote-Groups headers are believed. Unset, forward auth is off and those headers are ignored.
# FORWARD_AUTH_TRUSTED_PROXIES=172.18.0.0/16

# Groups whose members may change the homepage, besides the admin (the first account). Comma-separated.
# ADMIN_GROUPS=homepage-admins

# true lets people who are not signed in see the pages (never change them) once sign-in is set up.
# PUBLIC_VIEW=false

# Secrets for widgets. A widget's address, headers and body may say ${env:HOMEPAGE_SONARR_KEY}, which
# the server fills in when it fetches. Only variables starting with HOMEPAGE_ can be read this way.
# HOMEPAGE_SONARR_KEY=
