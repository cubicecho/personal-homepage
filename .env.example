# Where the page files live: site.yaml and pages/<slug>.yaml. Default ./data (relative to where the server starts).
# The Docker image sets it to /data, which docker-compose.yml mounts as a volume.
# To start from the sample pages: cp -r examples/data ./data
# DATA_DIR=./data

# Port the server listens on in production (`npm start`, Docker). Default 3000.
# `npm run dev` ignores it: the web app is on 3000 and the API on 8787.
# PORT=3000

# Proxies in front of this server that may set X-Forwarded-For. Default false (none).
# "1" for one reverse proxy; never "true" when the port is reachable from the internet.
# TRUST_PROXY=1

# The Open-Meteo forecast endpoint weather widgets ask. Default https://api.open-meteo.com/v1/forecast.
# Set it to a self-hosted Open-Meteo's /v1/forecast to keep weather requests on your network.
# WEATHER_API_URL=http://open-meteo.lan:8080/v1/forecast

# Secrets for widgets. A widget's address, headers and body may say ${env:HOMEPAGE_SONARR_KEY}, which
# the server fills in when it fetches. Only variables starting with HOMEPAGE_ can be read this way.
# HOMEPAGE_SONARR_KEY=
